  "motion": {
    "duration": { "tap": 120, "quick": 200, "base": 320, "slow": 520, "count": 800, "lap": 900 },
    "stagger": { "list": 60, "lane": 80, "maxItems": 6 },
    "easing": {
      "sprint": { "css": "cubic-bezier(0.16, 1, 0.3, 1)", "use": "binnenkomen, baan vullen, cijfers optellen" },
      "stride": { "css": "cubic-bezier(0.65, 0, 0.35, 1)", "use": "van toestand wisselen, tabbladen" },
      "exit": { "css": "cubic-bezier(0.4, 0, 1, 1)", "use": "verdwijnen" },
      "kick": { "css": "cubic-bezier(0.34, 1.56, 0.64, 1)", "use": "kudos, behaald doel" }
    },
    "spring": {
      "kick": { "response": 0.32, "dampingFraction": 0.55, "use": "kudos, behaald doel (SwiftUI .spring)" },
      "settle": { "response": 0.45, "dampingFraction": 0.85, "use": "kaarten, sheets" }
    },
    "patterns": {
      "ronde": "De baan loopt vol vanaf de startstreep, linksom: 900 ms, sprint. Meerdere banen starten 80 ms na elkaar. Bij 100% kleurt de finishstreep volt (200 ms).",
      "teller": "Cijfers tellen op van 0 (of van de vorige waarde) naar de nieuwe: 800 ms, sprint, tabelcijfers. Start gelijk met de baan.",
      "kudos": "Het icoon veert 1 → 1,25 → 1 (kick), kleurt tartan, het aantal telt één op. iOS: lichte haptische tik. Geluid: kudos.",
      "binnenkomst": "Kaarten en lijstregels komen 12 px omhoog met een fade: 320 ms, sprint, 60 ms na elkaar, hooguit zes; de rest staat er direct.",
      "druk": "Knoppen en kaarten krimpen bij indrukken naar 0,97: 120 ms.",
      "startschot": "Opname starten: 3, 2, 1 als grote baannummers (elk 700 ms), dan de startpiep en een zware haptische tik.",
      "finish": "Opname klaar: de samenvatting schuift in (520 ms, sprint), de cijfers tellen op, de baan loopt vol; bij een record één volt-flits op de finishstreep.",
      "live": "Tijdens een opname knippert alleen de volt live-stip (1 s, zacht); verder beweegt niets doorlopend."
    },
    "reducedMotion": "Geen verplaatsing, schaal of doorveren. Baan en cijfers tonen direct de eindwaarde; overgangen worden een fade van 120 ms. De live-stip staat stil. Haptiek en geluid blijven."
